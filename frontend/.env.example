# Base URL of the backend API — no trailing slash, no /api suffix.
# In development this is http://localhost:3001.
# In production, set this to your Railway/Render backend URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Your backend domain only (no protocol, no path) — used by next.config.js
# to allowlist avatar/upload images served from the backend.
# Example: api.guestspeak.app
NEXT_PUBLIC_API_HOST=

# Optional: Supabase project URL — used by next.config.js to allowlist
# Supabase Storage image domains.
# Example: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Early access waitlist form endpoint.
# Mailchimp: paste your embedded form's `action` URL here.
# Beehiiv / ConvertKit / any provider: same pattern.
# If left empty, the form shows a success state immediately (good for Vercel-only deploys).
NEXT_PUBLIC_WAITLIST_URL=

# Canonical public URL — metadataBase, canonical tags, Open Graph.
# Defaults to https://guestspeak.app. Set it on preview deployments so their
# share cards and canonical tags describe themselves rather than production.
NEXT_PUBLIC_SITE_URL=
