# ── Database ──────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) to stay within connection limits.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres

# CA certificate used to VERIFY the database's TLS certificate in production.
# Without it the connection is encrypted but unauthenticated (MITM-able), and
# the server logs a warning on boot.
# Supabase: Settings → Database → SSL Configuration → download certificate.
# Paste the PEM here; literal \n escapes are fine.
DATABASE_CA_CERT=

# Simultaneous database connections (default 50). This is the server's overall
# throughput ceiling, not a per-user limit — one question costs ~8 sequential
# queries, one echo ~6, and each in-flight request holds a connection throughout.
#
# Set this to what the database will actually accept, not to what you wish it
# were. In production that means Supabase's transaction pooler (port 6543), whose
# client-connection ceiling depends on your plan — check it before raising this.
# Overshooting causes refused connections, which is worse than queuing.
#
# For a multi-track conference, raise it here rather than in code: a local
# PostgreSQL typically allows only 100 connections in total.
DB_POOL_MAX=50

# ── Feed scaling ──────────────────────────────────────────────────────────────
# Max concurrent SSE clients per session (default 500). Hosts and moderators are
# exempt from this cap; the audience above it is told to poll instead.
SSE_MAX_CLIENTS_PER_SESSION=500

# Above this participant count the audience stops receiving a live SSE stream and
# polls the cached feed instead (default 400). Per-event fan-out costs one socket
# write per client per event, which does not survive a very large room.
# Hosts and moderators always keep the live stream.
LIVE_FEED_MAX_PARTICIPANTS=400

# How often polling clients re-fetch the feed, in ms (default 5000).
FEED_POLL_INTERVAL_MS=5000

# How long the audience feed is cached server-side, in ms (default 2000). This is
# what makes polling cheap: N pollers cost roughly one query per TTL, not N.
# Moderation actions invalidate the cache immediately, so hiding a question is
# never delayed by it.
FEED_CACHE_TTL_MS=2000

# Max distinct guest tokens per IP per session (default 2000; 0 disables).
# Blunts credit farming, but IP is a poor identity signal at venue scale — a
# conference NAT or a stadium's carrier NAT puts thousands of real attendees
# behind one address. Set to 0 for large ticketed events.
GUEST_IP_TOKEN_CAP=2000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── URLs ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL — no trailing slash
FRONTEND_URL=https://guestspeak.vercel.app
# Used to build links in notification/reset emails — same as FRONTEND_URL
APP_URL=https://guestspeak.vercel.app

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Resend (https://resend.com) has a generous free tier and works well with Railway.
# Postmark and SendGrid are also good options.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=GuestSpeak <noreply@yourdomain.com>

# ── File uploads (Cloudflare R2) ──────────────────────────────────────────────
# Local disk is used when these are absent (fine for dev, ephemeral on Railway).
# To enable R2: create a bucket, generate an API token with Object Read & Write,
# enable "R2 Public Access" on the bucket, copy the public URL.
#
# R2 dashboard: dash.cloudflare.com → R2 → your bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=guestspeak-uploads
# Public URL for the bucket — enable in R2 dashboard → Public Access
# e.g. https://pub-abc123.r2.dev  OR a custom domain
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Web push (optional) ───────────────────────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
#
# The public key is shipped to browsers and is not a secret. The private key is.
# These are bound to every subscription created with them: rotating the pair
# silently breaks every existing subscription and forces everyone to re-enable
# notifications. Generate once, back them up, leave them alone.
#
# Leave unset to disable push entirely — in-app notifications and email are
# unaffected, and the notification toggle hides itself rather than offering
# something that cannot work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach you at. mailto: or https: only.
VAPID_SUBJECT=mailto:support@guestspeak.app

# ── Redis (required for more than one replica) ────────────────────────────────
# Carries SSE events between replicas. Leave unset for a single instance —
# events are then delivered in-process, which is correct and needs no Redis.
#
# Running 2+ replicas WITHOUT this silently breaks live updates for part of every
# audience: a client on replica A never sees events produced on replica B, with
# no error on either side. Railway: add a Redis service and reference its URL.
REDIS_URL=

# ── Error reporting (optional) ────────────────────────────────────────────────
# Sentry DSN. Leave unset to disable — local development and the test suites run
# without it and need no key.
#
# Sentry is organisation -> projects, so an existing account does not need a new
# one: add a project alongside any others and use its DSN here.
#
# Only genuine server faults are reported. Client mistakes — malformed JSON, a
# bad identifier, an unauthenticated request — are classified as 4xx and never
# sent, which is what keeps the issue stream worth reading.
SENTRY_DSN=

# ── Nightly backup (Railway cron service only) ───────────────────────────────
# Private R2 bucket for database dumps. Deliberately NOT R2_BUCKET: that one is
# public-read for avatars, and a dump there would expose every account, question
# and email address. See docs/backups.md.
R2_BACKUP_BUCKET=

# Public base URL of this API, used to build unsubscribe links that must work
# from an inbox years later. Falls back to APP_URL, then localhost.
# Example: https://api.guestspeak.app
API_PUBLIC_URL=
